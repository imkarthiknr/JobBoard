# Copy to .env and adjust. Every setting can also be passed as an environment variable.

# SQLite (zero setup) ...
DATABASE_URL=sqlite:///./jobboard.db
# ... or PostgreSQL:
# DATABASE_URL=postgresql+psycopg://jobboard:jobboard@localhost:5432/jobboard

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Set to true when served over HTTPS.
COOKIE_SECURE=false
